{
  "name": "@hexclave/temporal",
  "version": "1.0.139",
  "repository": "https://github.com/hexclave/hexclave",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": {
        "default": "./dist/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "require": {
        "default": "./dist/workflows/index.js"
      },
      "default": "./dist/esm/workflows/index.js"
    },
    "./activities": {
      "types": "./dist/activities/index.d.ts",
      "require": {
        "default": "./dist/activities/index.js"
      },
      "default": "./dist/esm/activities/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "clean": "rimraf dist && rimraf node_modules",
    "dev": "tsdown --watch",
    "lint": "eslint --ext .tsx,.ts .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "@hexclave/shared": "workspace:*"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@types/node": "20.19.43",
    "rimraf": "^6.1.4"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
